{
  "realm": "fincore",
  "displayName": "FinCore (DEV ONLY - local Keycloak)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clients": [
    {
      "clientId": "fincore-api",
      "name": "FinCore API",
      "description": "Resource server / token audience. Bearer-only: no login flows.",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false
    },
    {
      "clientId": "fincore-backoffice",
      "name": "FinCore Back Office BFF",
      "description": "Confidential client used by the Back Office BFF (https://localhost:7200). Secret is DEV ONLY.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "fincore-backoffice-dev-only-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://localhost:7200",
      "baseUrl": "/",
      "redirectUris": ["https://localhost:7200/*"],
      "webOrigins": ["+"],
      "frontchannelLogout": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:7200/*"
      },
      "protocolMappers": [
        {
          "name": "audience-fincore-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fincore-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "fincore-portal",
      "name": "FinCore Customer Portal BFF",
      "description": "Confidential client used by the Portal BFF (https://localhost:7201). Secret is DEV ONLY.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "fincore-portal-dev-only-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://localhost:7201",
      "baseUrl": "/",
      "redirectUris": ["https://localhost:7201/*"],
      "webOrigins": ["+"],
      "frontchannelLogout": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:7201/*"
      },
      "protocolMappers": [
        {
          "name": "audience-fincore-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fincore-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "fincore-mobile",
      "name": "FinCore Mobile App",
      "description": "Public client for the Expo app: Auth Code + PKCE (S256) required, short access tokens, rotating refresh tokens. exp://* is for Expo Go in development only.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["fincore://auth/callback", "exp://*"],
      "webOrigins": [],
      "frontchannelLogout": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300",
        "post.logout.redirect.uris": "fincore://auth/callback##exp://*"
      },
      "protocolMappers": [
        {
          "name": "audience-fincore-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fincore-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "sysadmin",
      "enabled": true,
      "email": "sysadmin@fincore.local",
      "emailVerified": true,
      "firstName": "System",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "Sysadmin-dev-only-1!",
          "temporary": false
        }
      ],
      "requiredActions": []
    }
  ]
}
