      "post": {
        "tags": [
          "Institutions"
        ],
        "summary": "Close an institution for good (all branches must be closed)",
        "operationId": "CloseInstitution",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
