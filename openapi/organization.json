    "/api/v1/institutions/{institutionId}/branches/{branchId}/close": {
      "post": {
        "tags": [
          "Branches"
        ],
        "summary": "Close a branch (no active staff or child branches may remain)",
        "operationId": "CloseBranch",
        "parameters": [
          {
            "name": "institutionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "branchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
