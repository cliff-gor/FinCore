  <ItemGroup>
    <ProjectReference Include="..\..\..\src\BuildingBlocks\FinCore.SharedKernel\FinCore.SharedKernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>
</Project>
