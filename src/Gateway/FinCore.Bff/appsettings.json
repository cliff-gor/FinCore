{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5100" }
        }
      }
    }
  }
}
