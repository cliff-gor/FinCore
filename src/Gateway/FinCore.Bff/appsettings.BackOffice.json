{
  "Bff": {
    "Oidc": {
      // Staff realm (spec 002): staff and customer tokens come from different issuers.
      "Authority": "http://localhost:8080/realms/fincore-staff",
      "ClientId": "fincore-backoffice"
      // ClientSecret is never stored here: launchSettings.json / the AppHost supply the dev-only value, other
      // environments their secret store (Bff__Oidc__ClientSecret).
    },
    "Session": {
      // Staff: 30 min idle (sliding), 10 h absolute (spec 002 "Session lifetimes").
      "IdleTimeout": "00:30:00",
      "AbsoluteLifetime": "10:00:00"
    }
  }
}
