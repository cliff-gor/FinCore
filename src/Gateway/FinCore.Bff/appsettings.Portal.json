{
  "Bff": {
    "Oidc": {
      // Customer realm (spec 002): a customer token can never pass as a staff token.
      "Authority": "http://localhost:8080/realms/fincore-customers",
      "ClientId": "fincore-portal"
      // ClientSecret is never stored here: launchSettings.json / the AppHost supply the dev-only value, other
      // environments their secret store (Bff__Oidc__ClientSecret).
    },
    "Session": {
      // Customers: 15 min idle (sliding), 8 h absolute (spec 002 "Session lifetimes").
      "IdleTimeout": "00:15:00",
      "AbsoluteLifetime": "08:00:00"
    }
  }
}
