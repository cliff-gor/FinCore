{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Quartz": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "fincore": ""
  },
  "Auth": {
    "RequireHttpsMetadata": true,
    "Staff": {
      "Authority": "",
      "Audience": "fincore-api"
    },
    "Customers": {
      "Authority": "",
      "Audience": "fincore-api-customers"
    }
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDevData": false
  },
  "Mobile": {
    "MinimumVersion": "0.1.0"
  },
  "Modules": {
    "Organization": { "Enabled": true },
    "Identity": { "Enabled": true }
  },
  "Approvals": {
    "ExpiryDays": 7,
    "LimitRaiseSecondCheckerThreshold": 1000000
  }
}
