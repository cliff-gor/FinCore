{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Quartz": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "fincore": ""
  },
  "Auth": {
    "Authority": "",
    "Audience": "fincore-api",
    "RequireHttpsMetadata": true
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDevData": false
  },
  "Mobile": {
    "MinimumVersion": "0.1.0"
  },
  "Modules": {
    "Organization": { "Enabled": true }
  }
}
