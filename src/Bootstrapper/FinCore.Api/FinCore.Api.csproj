<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>FinCore.Api</RootNamespace>
    <UserSecretsId>fincore-api-dev</UserSecretsId>
    <!-- Build-time OpenAPI export: the committed snapshot in /openapi feeds the frontend client (spec 001). -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name fincore</OpenApiGenerateDocumentsOptions>
    <!-- Container publish (dotnet publish /t:PublishContainer), ARM64 for Fargate Graviton (spec §33.3). -->
    <ContainerRepository>fincore-api</ContainerRepository>
    <ContainerFamily>noble-chiseled</ContainerFamily>
    <ContainerRuntimeIdentifier>linux-arm64</ContainerRuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildTimeUtc" Value="$([System.DateTime]::UtcNow.ToString('o'))" />
    <InternalsVisibleTo Include="FinCore.IntegrationTests.Shared" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Aspire\FinCore.ServiceDefaults\FinCore.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\FinCore.BuildingBlocks.Web\FinCore.BuildingBlocks.Web.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\FinCore.BuildingBlocks.Infrastructure\FinCore.BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Organization\FinCore.Modules.Organization.Infrastructure\FinCore.Modules.Organization.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Organization\FinCore.Modules.Organization.Presentation\FinCore.Modules.Organization.Presentation.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\FinCore.Modules.Identity.Infrastructure\FinCore.Modules.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\FinCore.Modules.Identity.Presentation\FinCore.Modules.Identity.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
  </ItemGroup>
  <!-- The generator names files fincore_<document>.json; publish them as <document>.json (e.g. organization.json). -->
  <Target Name="RenameOpenApiDocuments" AfterTargets="GenerateOpenApiDocuments">
    <ItemGroup>
      <_FinCoreOpenApiDoc Include="$(OpenApiDocumentsDirectory)/fincore_*.json" />
    </ItemGroup>
    <Move SourceFiles="@(_FinCoreOpenApiDoc)" DestinationFiles="@(_FinCoreOpenApiDoc->'$(OpenApiDocumentsDirectory)/$([System.String]::Copy('%(Filename)').Replace('fincore_', '')).json')" />
  </Target>
</Project>
